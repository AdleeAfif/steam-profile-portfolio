---
import type { CountLink } from "./types";

interface Props {
  links: CountLink[];
}

const { links } = Astro.props;
---

<nav aria-label="Profile sections">
  <ul class="space-y-0.5">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex items-baseline justify-between gap-2 px-1 py-1 text-steam-text no-underline hover:bg-black/30 hover:text-white"
          >
            <span>{link.label}</span>
            <span class="text-lg font-light text-white">{link.value ?? "-"}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
