---
import type { Achievement } from "../../lib/api/types";
import { formatDate } from "../../lib/format";

interface Props {
  achievement: Achievement;
}

const { achievement } = Astro.props;
---

<a href="/achievements" class="flex items-center gap-4 text-steam-text no-underline hover:text-white">
  <span
    aria-hidden="true"
    class="grid h-16 w-16 shrink-0 place-items-center bg-gradient-to-br from-[#e5b143] to-[#7a5418] text-2xl text-white"
  >
    {achievement.glyph}
  </span>
  <span class="min-w-0 space-y-0.5">
    <span class="block text-white">{achievement.name}</span>
    <span class="block text-sm text-steam-muted">{achievement.description}</span>
    <span class="block text-xs">
      <span class="text-[#e5b143]">{achievement.globalPercent.toLocaleString("en-US", { maximumFractionDigits: 1 })}% of players</span>
      {achievement.unlockedAt && <span class="text-steam-muted"> · unlocked {formatDate(achievement.unlockedAt)}</span>}
    </span>
  </span>
</a>
