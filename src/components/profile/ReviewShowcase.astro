---
import type { Review } from "../../lib/api/types";
import { formatDate } from "../../lib/format";

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
---

<ul class="space-y-3">
  {
    reviews.map((review) => (
      <li class="bg-black/20">
        <div class:list={["flex items-center gap-3 p-2", review.recommended ? "bg-[#1f3a52]" : "bg-[#3a2222]"]}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class:list={["h-8 w-8", review.recommended ? "text-steam-accent" : "rotate-180 text-[#c35b5b]"]} fill="currentColor">
            <path d="M2 21h4V9H2v12Zm20-11a2 2 0 0 0-2-2h-6.3l1-4.6v-.3a1.5 1.5 0 0 0-.4-1L13.2 1 6.6 7.6A2 2 0 0 0 6 9v10a2 2 0 0 0 2 2h9a2 2 0 0 0 1.8-1.2l3-7.1c.1-.2.2-.5.2-.7v-2Z" />
          </svg>
          <span class="text-white">{review.recommended ? "Recommended" : "Not Recommended"}</span>
        </div>
        <blockquote class="space-y-2 p-3 text-sm">
          <p class="whitespace-pre-line">{review.text}</p>
          <footer class="text-xs text-steam-muted">
            <span class="text-steam-text">{review.author}</span>
            {review.authorRole && <span>, {review.authorRole}</span>}
            {review.date && <span> · {formatDate(review.date)}</span>}
          </footer>
        </blockquote>
      </li>
    ))
  }
</ul>
