---
import { formatDate } from "../../lib/format";
import type { Achievement } from "../../lib/api/types";

interface Props {
  achievement: Achievement;
}

const { achievement: a } = Astro.props;
const unlocked = !!a.unlockedAt;
---

<li class:list={["flex items-center gap-4 rounded-sm bg-black/20 p-3", !unlocked && "opacity-60"]}>
  <span
    aria-hidden="true"
    class:list={[
      "grid h-16 w-16 shrink-0 place-items-center rounded-sm text-3xl",
      unlocked ? "bg-gradient-to-br from-[#2a6c9e] to-[#0e141b]" : "bg-[#2a2f36] grayscale",
    ]}
  >
    {a.glyph}
  </span>
  <span class="min-w-0 flex-1">
    <span class:list={["block", unlocked ? "text-white" : "text-steam-muted"]}>{a.name}</span>
    <span class="block text-sm text-steam-muted">{a.description}</span>
    <span class="mt-1 block text-xs text-steam-muted">{a.globalPercent.toLocaleString("en-US", { maximumFractionDigits: 1 })}% of players have this achievement</span>
  </span>
  <span class="shrink-0 text-right text-xs">
    {
      unlocked ? (
        <span class="text-steam-text">
          Unlocked
          <span class="block text-steam-muted">{formatDate(a.unlockedAt)}</span>
        </span>
      ) : (
        <span class="text-steam-muted">Locked</span>
      )
    }
  </span>
</li>
