---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Error">
  <div class="steam-panel mx-auto max-w-xl text-center">
    <h1 class="mb-2 text-2xl font-light text-white">Error</h1>
    <p class="text-steam-muted">The specified profile, item or page could not be found.</p>
    <a href="/" class="btn-steam btn-blue mt-4">Return to profile</a>
  </div>
</BaseLayout>
